# Copy to terraform.tfvars (git-ignored) and fill in. Keep the CRM secret out of
# files: export TF_VAR_crm_client_secret=... in the shell or the pipeline instead.
subscription_id     = "00000000-0000-0000-0000-000000000000"
location            = "uksouth"
name_prefix         = "wh"
sql_admin_login     = "Data Platform Admins"
sql_admin_object_id = "00000000-0000-0000-0000-000000000000"
client_ip_addresses = []
alert_email         = "data-alerts@example.org"
crm_api_base_url    = "https://crm.example.org/api"
crm_client_id       = "warehouse-loader"

# After the first image push:
# image = "acrwhxxxxx.azurecr.io/warehouse:<git sha>"
